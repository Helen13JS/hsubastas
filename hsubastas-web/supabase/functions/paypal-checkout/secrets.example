# Solo servidor: copiar a un archivo local ignorado (ej. .env.paypal-server).
# No usar el prefijo VITE_ para estos secretos.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=REEMPLAZAR_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=REEMPLAZAR_SECRET_SANDBOX
# Comisión: 3% de la adjudicación en BOB. Tipo de cambio comercial: BOB por 1 USD.
# Configurar el cambio acordado; no es una cotización automática ni una tarifa fija.
PAYPAL_BOB_PER_USD=
APP_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://hsubastas.com.bo
